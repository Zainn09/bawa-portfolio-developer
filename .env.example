# Actual HTTPS site origin; leave empty for noindex previews.
NEXT_PUBLIC_SITE_URL=
# Existing contact delivery (independent of the blog database).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Supabase Dashboard → Connect / API keys. Configure in deployment settings.
# Use a publishable key, NEVER a service-role key or database password.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep "files" until migration, admin access, and the 35-article import are verified.
# Set to "database" and redeploy to enable public database publishing.
BLOG_CONTENT_SOURCE=files
