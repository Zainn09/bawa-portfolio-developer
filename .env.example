# Actual HTTPS site origin; leave empty for noindex previews.
NEXT_PUBLIC_SITE_URL=
# Existing contact delivery (independent of the blog database).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Supabase Dashboard → Connect / API keys. Configure in deployment settings.
# Use a publishable key, NEVER a service-role key or database password.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep "files" until migration, admin access, and the 35-article import are verified.
# Set to "database" and redeploy to enable public database publishing.
BLOG_CONTENT_SOURCE=files

# Analytics (optional overrides)
# GA4 tag id; defaults to G-JZZR2B3JTH when left empty.
GA_MEASUREMENT_ID=
# AdSense publisher id (client); defaults to ca-pub-4078729434854717 when
# left empty. The base loader only preloads the AdSense client; no ad units
# are rendered until approved placements are added.
GOOGLE_ADSENSE_CLIENT_ID=
# The Google tags already load on Vercel (VERCEL=1). Set to 1 to load them on
# a non-Vercel production host as well. Local previews never send telemetry.
ENABLE_ANALYTICS=
